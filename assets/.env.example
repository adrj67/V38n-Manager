# Configuración de ejemplo para V38n Manager
# Copia este archivo a .env y completa con tus datos
# El archivo .env está en .gitignore, no se subirá al repositorio

CAMERA_1_NAME=Camara Garaje
CAMERA_1_IP=192.168.1.100
CAMERA_1_RTSP_URL=rtsp://192.168.1.100:554/live/ch00_0
CAMERA_1_ONVIF_URL=http://192.168.1.100/onvif/device_service
CAMERA_1_USERNAME=admin
CAMERA_1_PASSWORD=123456

CAMERA_2_NAME=Camara Jardin
