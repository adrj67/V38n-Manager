CAMERA_2_RTSP_URL=rtsp://192.168.1.101:554/live/ch00_0
CAMERA_2_ONVIF_URL=http://192.168.1.101/onvif/device_service
CAMERA_2_USERNAME=admin
CAMERA_2_PASSWORD=123456